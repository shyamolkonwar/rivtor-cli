{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "declaration": true,
    "sourceMap": true, "forceConsistentCasingInFileNames": true, "outDir": "dist", "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test"]
}
